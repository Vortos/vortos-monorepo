# .env.example — committed template. Copy to .env and run: php vortos setup
#
# vortos:setup will generate and populate .env automatically.
# In production, inject these as real environment variables — do not use .env files.

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
APP_NAME=your_app_name
APP_ENV=dev
APP_DEBUG=true

# ----------------------------------------------------------
# HTTP / Runtime
# ----------------------------------------------------------
SERVER_NAME=:80
WORKER_NUM=4
FRANKENPHP_WATCH=watch

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
JWT_SECRET=
HEALTH_TOKEN=
HEALTH_DETAILS=debug
HEALTH_EXPOSE_ERRORS=false

# ----------------------------------------------------------
# Write Database
# ----------------------------------------------------------
VORTOS_WRITE_DB_DRIVER=postgres
VORTOS_WRITE_DB_DSN=pgsql://postgres:changeme@write_db:5432/your_app_name
VORTOS_WRITE_DB_USER=postgres
VORTOS_WRITE_DB_PASSWORD=changeme
VORTOS_WRITE_DB_NAME=your_app_name

# ----------------------------------------------------------
# Read Database
# ----------------------------------------------------------
VORTOS_READ_DB_DRIVER=mongo
VORTOS_READ_DB_DSN=mongodb://root:changeme@read_db:27017
VORTOS_READ_DB_NAME=your_app_name
VORTOS_READ_DB_USER=root
VORTOS_READ_DB_PASSWORD=changeme

# ----------------------------------------------------------
# Cache
# ----------------------------------------------------------
VORTOS_CACHE_DRIVER=redis
VORTOS_CACHE_DSN=redis://redis:6379
VORTOS_CACHE_PREFIX=dev_your_app_name_

# ----------------------------------------------------------
# Messaging
# ----------------------------------------------------------
VORTOS_MESSAGING_DRIVER=kafka
VORTOS_MESSAGING_DSN=kafka://kafka:9092
