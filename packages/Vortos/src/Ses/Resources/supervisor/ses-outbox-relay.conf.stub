; Vortos SES — Outbox Relay Worker
;
; Add this block to your docker/worker/supervisord.conf ONLY if outbox.enabled
; is set to true in your SES config. If the outbox is disabled, this process
; will poll an empty table and waste CPU cycles.
;
; After adding, rebuild and restart the worker container:
;   docker compose build worker
;   docker compose up -d worker

[program:ses-outbox-relay]
command=php /var/www/html/bin/console ses:outbox:relay
autostart=true
autorestart=true
startsecs=3
stopwaitsecs=30
stdout_logfile=/var/log/supervisor/ses-outbox-relay.out.log
stderr_logfile=/var/log/supervisor/ses-outbox-relay.err.log
