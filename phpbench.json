{
    "$schema": "vendor/phpbench/phpbench/phpbench.schema.json",
    "runner.bootstrap": "vendor/autoload.php",
    "runner.path": "packages/Vortos/src/FeatureFlags/Tests/Benchmark",
    "runner.php_config": {
        "opcache.enable": "1",
        "opcache.enable_cli": "1",
        "opcache.jit": "tracing",
        "opcache.jit_buffer_size": "256M",
        "xdebug.mode": "off"
    },
    "report.generators": {
        "aggregate": {
            "extends": "aggregate"
        }
    },
    "assertion.warn_on_failure": false,
    "storage": "json",
    "storage.json_path": "packages/Vortos/src/FeatureFlags/Tests/Benchmark/baseline"
}
