<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">

    <php>
        <ini name="memory_limit" value="512M"/>
        <!--
            Auto-prune registers a framework-owned static schedule
            (PruneSchedulerRunsSchedule) whenever SchedulerExtension is loaded with
            DBAL available and retention non-zero (production default: 30 days).
            Defaulting it to 0 (disabled) here keeps every existing test that builds
            a full Scheduler container and asserts an exact static-schedule count
            unaffected. Tests that specifically exercise auto-prune override this
            via $_ENV directly (see Tests/Integration/RetentionScheduleRegistrationTest.php)
            or bypass SchedulerExtension and construct services directly.
        -->
        <env name="SCHEDULER_RUN_RETENTION_DAYS" value="0"/>
    </php>

